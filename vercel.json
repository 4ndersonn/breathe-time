{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/__main__.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "backend/app/data/processed/**"
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/__main__.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
